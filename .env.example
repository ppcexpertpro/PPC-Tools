DATABASE_URL=postgres://postgres:postgres@localhost:5432/outreach

# Generate each of these with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=
UNSUBSCRIBE_SECRET=

# Shared-secret gate (proxy.ts) protecting every /outreach and /api/outreach
# route except the unsubscribe link. Phase 1 is single-operator, so this is
# one shared login rather than a full accounts system. Required - proxy.ts
# fails closed (denies all access) if either is unset.
OUTREACH_ACCESS_USER=
OUTREACH_ACCESS_PASSWORD=
