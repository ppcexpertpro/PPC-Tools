DATABASE_URL=postgres://postgres:postgres@localhost:5432/outreach

# Generate each of these with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=
UNSUBSCRIBE_SECRET=

# Optional. The worker/poller run in-process automatically once deployed
# (NODE_ENV=production) - see instrumentation.ts. Set to "true" to also run
# them under `next dev`, or "false" on every instance but one if this app is
# ever scaled to more than a single running process.
# OUTREACH_BACKGROUND_JOBS=
